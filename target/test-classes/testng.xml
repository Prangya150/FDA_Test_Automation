<?xml version="1.0" encoding="UTF-8"?>
<!-- parallel execution removed: all TC_FBS_00N tests now share one browser session/login
     (see SuiteLoginListener), and a single WebDriver cannot safely be driven by two threads
     at once. Tests run sequentially, in the order listed below. -->
<suite name="FDA Test Automation Suite" verbose="1">

    <listeners>
        <listener class-name="com.fda.automation.listeners.TestListener"/>
        <!-- Logs into FDA and Mirakl exactly once for the whole suite (onStart), and logs out /
             closes the browser once everything has finished (onFinish) - see the class doc. -->
        <listener class-name="com.fda.automation.listeners.SuiteLoginListener"/>
    </listeners>

    <test name="TC_FBS_001">
        <classes>
            <class name="com.fda.automation.tests.fbs.TC_FBS_001_Test"/>
        </classes>
    </test>

    <test name="TC_FBS_002">
        <classes>
            <class name="com.fda.automation.tests.fbs.TC_FBS_002_Test"/>
        </classes>
    </test>

    <test name="TC_FBS_003">
        <classes>
            <class name="com.fda.automation.tests.fbs.TC_FBS_003_Test"/>
        </classes>
    </test>

    <test name="TC_FBS_004">
        <classes>
            <class name="com.fda.automation.tests.fbs.TC_FBS_004_Test"/>
        </classes>
    </test>

    <test name="TC_FBS_005">
        <classes>
            <class name="com.fda.automation.tests.fbs.TC_FBS_005_Test"/>
        </classes>
    </test>

    <test name="TC_FBS_006">
        <classes>
            <class name="com.fda.automation.tests.fbs.TC_FBS_006_Test"/>
        </classes>
    </test>

    <test name="TC_FBS_007">
        <classes>
            <class name="com.fda.automation.tests.fbs.TC_FBS_007_Test"/>
        </classes>
    </test>

</suite>
